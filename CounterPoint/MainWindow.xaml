<Window x:Class="CounterPoint.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CounterPoint • Point of Sale" Width="1280" Height="820" MinWidth="1050" MinHeight="700" Background="#F3F3F3" FontFamily="Segoe UI Variable" FontSize="14">
 <DockPanel Margin="24">
  <Grid DockPanel.Dock="Top" Margin="0,0,0,22"><StackPanel><TextBlock Text="COUNTERPOINT" FontSize="26" FontWeight="Bold" Foreground="#0F172A"/><TextBlock Text="Your shop. Every sale, in order." Foreground="#6C7B89" Margin="0,4,0,0"/></StackPanel><StackPanel HorizontalAlignment="Right"><TextBlock Text="LOCAL COUNTER" Foreground="#0067C0" FontWeight="Bold" HorizontalAlignment="Right"/><TextBlock x:Name="TodaySummary" Margin="0,8,0,0"/></StackPanel></Grid>
  <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="4,14,0,0" Foreground="#0067C0" Text="Ready for your next customer."/>
  <TabControl x:Name="MainTabs" Background="Transparent" BorderThickness="0">
   <TabItem Header="Sell"><Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="440"/></Grid.ColumnDefinitions>
    <DockPanel Margin="0,0,20,0"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Customer (optional)" Margin="4,0"/><ComboBox x:Name="SaleCustomer" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="4" Padding="8"/><Button Content="Use walk-in customer" HorizontalAlignment="Left" Click="WalkIn"/></StackPanel><TextBox x:Name="Search" DockPanel.Dock="Top" ToolTip="Search name, category or barcode. Press Enter to add an exact barcode." TextChanged="SearchChanged" KeyDown="SearchKeyDown"/><TextBlock DockPanel.Dock="Top" Text="PRODUCT CATALOG   /   Double-click to add" Foreground="#6C7B89" Margin="4,16,4,12"/>
     <Button DockPanel.Dock="Bottom" Content="+ Add selected to cart" Click="AddSelected"/>
     <DataGrid x:Name="ProductsGrid" MouseDoubleClick="AddSelected"><DataGrid.Columns><DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/><DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=N2}" Width="90"/><DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="70"/></DataGrid.Columns></DataGrid>
    </DockPanel>
    <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="16"><DockPanel>
     <StackPanel DockPanel.Dock="Top"><TextBlock Text="Current sale" FontSize="22" FontWeight="SemiBold" Margin="4,0,0,10"/><TextBlock Text="Select a line to adjust its quantity" Foreground="#6C7B89" Margin="4,0,0,12"/></StackPanel>
     <StackPanel DockPanel.Dock="Bottom"><StackPanel Orientation="Horizontal"><Button Content="−" Click="Decrease"/><Button Content="+" Click="Increase"/><Button Content="Remove" Click="Remove"/><Button Content="Clear" Click="Clear"/></StackPanel>
      <Grid Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Discount amount" Margin="4,0"/><TextBox x:Name="Discount" Text="0" TextChanged="TotalsChanged"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Tax %" Margin="4,0"/><TextBox x:Name="TaxRate" Text="0" TextChanged="TotalsChanged"/></StackPanel></Grid>
      <TextBlock x:Name="Breakdown" Margin="4,4" Foreground="#6C7B89"/><TextBlock x:Name="TotalLabel" FontSize="30" FontWeight="Bold" Foreground="#0F172A" Margin="4,4,0,14"/>
      <ComboBox x:Name="Payment" SelectedIndex="0" Padding="10" Margin="4"><ComboBoxItem Content="Cash"/><ComboBoxItem Content="Card"/></ComboBox><TextBlock Text="Cash received (cash payments only)" Margin="4,8,4,0"/><TextBox x:Name="Tendered" Text="0"/><Button Content="Complete sale →" Click="Checkout" Padding="16,16"/>
     </StackPanel>
     <DataGrid x:Name="CartGrid"><DataGrid.Columns><DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="45"/><DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="85"/></DataGrid.Columns></DataGrid>
    </DockPanel></Border>
   </Grid></TabItem>
   <TabItem Header="Inventory"><DockPanel Margin="0,18,0,0"><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12"><Button Content="+ New product" Click="NewProduct"/><Button Content="Edit selected product" Click="EditProduct"/><TextBlock Text="Manage prices, barcodes and available stock" VerticalAlignment="Center" Margin="16,0" Foreground="#6C7B89"/></StackPanel><DataGrid x:Name="InventoryGrid"><DataGrid.Columns><DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Barcode / SKU" Binding="{Binding Barcode}" Width="180"/><DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="180"/><DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=N2}" Width="120"/><DataGridTextColumn Header="In stock" Binding="{Binding Stock}" Width="100"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
   <TabItem Header="Sales history"><DockPanel Margin="0,18,0,0"><Button DockPanel.Dock="Top" Content="View / print selected receipt" HorizontalAlignment="Left" Click="ViewReceipt"/><DataGrid x:Name="SalesGrid" Margin="0,12,0,0" MouseDoubleClick="ViewReceipt"><DataGrid.Columns><DataGridTextColumn Header="Receipt" Binding="{Binding Number}" Width="*"/><DataGridTextColumn Header="Date / time" Binding="{Binding Time, StringFormat=yyyy-MM-dd HH:mm}" Width="200"/><DataGridTextColumn Header="Payment" Binding="{Binding Payment}" Width="140"/><DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="140"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
  </TabControl>
 </DockPanel>
</Window>
